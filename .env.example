# Environment Variables — copy this file to .env and fill in values.
# NEVER commit .env to git!

# Required for production (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrinova

# A random secret string — use a password generator
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

PORT=5000
NODE_ENV=production
