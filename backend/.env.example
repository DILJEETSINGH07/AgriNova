# ─────────────────────────────────────────────
#  AgriNova Backend — Environment Variables
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────
# For local dev: leave blank → uses in-memory MongoDB (auto-seeded)
# For production: paste your MongoDB Atlas connection string
MONGO_URI=

# ── Auth ─────────────────────────────────────
# Any random string, at least 32 chars
JWT_SECRET=agrinova_change_this_to_a_random_64char_string_in_production

# ── OpenAI (ChatGPT) ─────────────────────────
# Get key: https://platform.openai.com/api-keys
# Requires a few dollars of credit to work reliably
OPENAI_API_KEY=

# ── Email / SMTP (Gmail — FREE) ──────────────
# Steps:
#  1. Google Account → Security → 2-Step Verification → App Passwords
#  2. Generate App Password for "Mail"
#  3. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16char_app_password
FROM_NAME=AgriNova
FROM_EMAIL=your_gmail@gmail.com

# ── Razorpay Payments (TEST MODE — FREE) ─────
# Get test keys: https://dashboard.razorpay.com → Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ── Cloudinary Image Storage (FREE) ──────────
# Sign up: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
